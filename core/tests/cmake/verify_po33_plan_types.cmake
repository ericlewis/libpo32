file(MAKE_DIRECTORY "${WORK_DIR}")
foreach(kind IN ITEMS correct sample_as_pool pool_as_sample)
  set(pool_type "po33_pool_edit_plan_t")
  set(sample_type "po33_sample_edit_plan_t")
  if(kind STREQUAL "sample_as_pool")
    set(pool_type "po33_sample_edit_plan_t")
  elseif(kind STREQUAL "pool_as_sample")
    set(sample_type "po33_pool_edit_plan_t")
  endif()
  set(source "${WORK_DIR}/${kind}.c")
  file(WRITE "${source}" "#include \"po33.h\"\nint main(void) {\n${pool_type} pool;\n${sample_type} sample;\npo33_pool_edit_rebuild(0,0,0,0,0,&pool,0,0,0,0,0);\npo33_sample_edit_rebuild(0,0,0,0,0,&sample,0,0,0,0,0);\nreturn 0;\n}\n")
  execute_process(COMMAND "${COMPILER}" -std=c99 -Werror=incompatible-pointer-types
    -fsyntax-only "-I${INCLUDE_DIR}" "${source}"
    RESULT_VARIABLE result ERROR_VARIABLE diagnostic)
  if(kind STREQUAL "correct")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Correct plan types failed to compile: ${diagnostic}")
    endif()
  elseif(result EQUAL 0 OR NOT diagnostic MATCHES "incompatible")
    message(FATAL_ERROR "Mixed plan types were not rejected: ${kind}: ${diagnostic}")
  endif()
endforeach()
